/* Windows resource script generated by CMake from src/ebview.rc.in.
 *
 * This exists separately from src/ebview.rc because windres is invoked with
 * the build directory as its working directory, so the relative path used by
 * the autotools build ("../pixmaps/ebview.ico") would not resolve here. */
1 ICON "@EBVIEW_ICON_FILE@"

/* Version resource, so Explorer's Details tab and the property dialog show
 * something instead of blank fields.  The four numeric FILEVERSION fields are
 * built in CMake (@EBVIEW_VERSION_COMMA@) because PROJECT_VERSION is a dot
 * string ("0.4.0") that windres cannot parse, and because the tweak level is
 * empty for three-component versions.
 *
 * Everything is written as a plain number on purpose: GNU windres does not
 * accept the symbolic names by default (it rejects "FILETYPE VFT_APP" with a
 * syntax error, because winver.h is not part of the resource preprocessor
 * environment).  The MSVC names are given as comments instead.
 *
 * All strings below are ASCII: windres does not reliably honour a non-ASCII
 * codepage in .rc files, and the values are shown verbatim by Explorer. */
1 VERSIONINFO
FILEVERSION @EBVIEW_VERSION_COMMA@
PRODUCTVERSION @EBVIEW_VERSION_COMMA@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L              /* 0x1 = VS_FF_DEBUG */
FILEOS 0x00010004L          /* VOS_NT_WINDOWS32 */
FILETYPE 0x00000001L        /* VFT_APP */
FILESUBTYPE 0x0L            /* VFT2_UNKNOWN */
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"    /* 0x0409 English (US), 1200 Unicode */
        BEGIN
            VALUE "CompanyName", "Kenichi Suto"
            VALUE "FileDescription", "EPWING electronic dictionary viewer"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "ebview"
            VALUE "LegalCopyright", "Copyright (C) 2001-2004 Kenichi Suto. Licensed under GPL-2.0-or-later."
            VALUE "OriginalFilename", "ebview.exe"
            VALUE "ProductName", "EBView"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

--- a/eb/win32path.h
+++ b/eb/win32path.h
@@ -0,0 +1,199 @@
+/*
+ * win32path.h - filesystem access for paths that cannot be expressed in the
+ * system ANSI code page.
+ *
+ * The library passes paths around as `char *' and, on Windows, EBView hands
+ * them over as UTF-8 (that is the GLib filesystem encoding there).  The
+ * narrow-character C library entry points -- open(), opendir() -- interpret
+ * their argument in the *system ANSI code page*, so a dictionary directory
+ * whose name contains, say, Japanese or Chinese characters simply cannot be
+ * opened: the bytes are re-interpreted as ANSI, produce a different path and
+ * the call fails with ENOENT.
+ *
+ * The wrappers below convert the incoming string to UTF-16 and call the wide
+ * entry points instead.  A string that is not valid UTF-8 is retried as an
+ * ANSI string, so callers that still pass ANSI paths keep working.
+ *
+ * Only paths need this treatment.  The directory entries themselves (CATALOG,
+ * HONMON, *.ebz, ...) are ASCII in every EPWING/EB book, so entry names are
+ * converted back to UTF-8 and everything above this layer stays byte-oriented.
+ *
+ * This file is header-only on purpose: libeb's autotools build would otherwise
+ * need a new object added to eb/Makefile.am.
+ */
+
+#ifndef EB_WIN32PATH_H
+#define EB_WIN32PATH_H
+
+#include <stdlib.h>
+#include <string.h>
+#include <fcntl.h>
+
+#ifndef O_BINARY
+#define O_BINARY 0
+#endif
+
+#ifdef _WIN32
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <io.h>
+#include <wchar.h>
+#include <dirent.h>
+
+/*
+ * POSIX callers talk to `DIR *'; on Windows the wide variant is `_WDIR *'.
+ */
+typedef _WDIR EB_DIR;
+
+/* Longest directory entry name we hand back to the caller. */
+#define EB_WIN32_NAME_MAX 512
+
+/*
+ * Convert a UTF-8 (or, failing that, ANSI) path to a freshly allocated
+ * UTF-16 string.  Returns NULL if the path cannot be converted at all; the
+ * caller then just lets the operation fail, exactly as before.
+ */
+static inline wchar_t *
+eb_win32_wide_path(const char *path)
+{
+    wchar_t *wide;
+    int length;
+
+    if (path == NULL)
+	return NULL;
+
+    length = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, path, -1,
+	NULL, 0);
+    if (length > 0) {
+	wide = (wchar_t *)malloc((size_t)length * sizeof(wchar_t));
+	if (wide == NULL)
+	    return NULL;
+	if (MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, path, -1,
+		wide, length) > 0)
+	    return wide;
+	free(wide);
+    }
+
+    /*
+     * Not UTF-8.  Treat it as an ANSI path so that existing callers, and
+     * paths that came from the C runtime rather than from GLib, still work.
+     */
+    length = MultiByteToWideChar(CP_ACP, 0, path, -1, NULL, 0);
+    if (length <= 0)
+	return NULL;
+    wide = (wchar_t *)malloc((size_t)length * sizeof(wchar_t));
+    if (wide == NULL)
+	return NULL;
+    if (MultiByteToWideChar(CP_ACP, 0, path, -1, wide, length) <= 0) {
+	free(wide);
+	return NULL;
+    }
+
+    return wide;
+}
+
+/*
+ * open(path, O_RDONLY | O_BINARY), with `path' interpreted as UTF-8.
+ */
+static inline int
+eb_open_readonly(const char *path)
+{
+    wchar_t *wide;
+    int file;
+
+    wide = eb_win32_wide_path(path);
+    if (wide == NULL)
+	return -1;
+    file = _wopen(wide, _O_RDONLY | _O_BINARY);
+    free(wide);
+
+    return file;
+}
+
+static inline EB_DIR *
+eb_dir_open(const char *path)
+{
+    wchar_t *wide;
+    EB_DIR *dir;
+
+    wide = eb_win32_wide_path(path);
+    if (wide == NULL)
+	return NULL;
+    dir = _wopendir(wide);
+    free(wide);
+
+    return dir;
+}
+
+/*
+ * Return the next entry name as UTF-8, or NULL at the end of the directory.
+ * The returned pointer is valid until the next call; libeb walks one
+ * directory at a time, so a single buffer is enough.
+ */
+static inline const char *
+eb_dir_read_name(EB_DIR *dir)
+{
+    static char name[EB_WIN32_NAME_MAX];
+    struct _wdirent *entry;
+    int length;
+
+    entry = _wreaddir(dir);
+    if (entry == NULL)
+	return NULL;
+
+    length = WideCharToMultiByte(CP_UTF8, 0, entry->d_name, -1, name,
+	(int)sizeof(name), NULL, NULL);
+    if (length <= 0)
+	return NULL;
+    name[sizeof(name) - 1] = '\0';
+
+    return name;
+}
+
+static inline void
+eb_dir_close(EB_DIR *dir)
+{
+    _wclosedir(dir);
+}
+
+#else /* not _WIN32 */
+
+#include <unistd.h>
+#include <dirent.h>
+
+typedef DIR EB_DIR;
+
+static inline int
+eb_open_readonly(const char *path)
+{
+    return open(path, O_RDONLY | O_BINARY);
+}
+
+static inline EB_DIR *
+eb_dir_open(const char *path)
+{
+    return opendir(path);
+}
+
+static inline const char *
+eb_dir_read_name(EB_DIR *dir)
+{
+    struct dirent *entry;
+
+    entry = readdir(dir);
+
+    return (entry == NULL) ? NULL : entry->d_name;
+}
+
+static inline void
+eb_dir_close(EB_DIR *dir)
+{
+    closedir(dir);
+}
+
+#endif /* not _WIN32 */
+
+#endif /* EB_WIN32PATH_H */
